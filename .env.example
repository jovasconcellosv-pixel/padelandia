# Variables de Entorno para Supabase (Fase 1)
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Variables de Entorno para WhatsApp Cloud API (Fase 2)
# Token de acceso (Temporal o Permanente) de Meta for Developers
WHATSAPP_TOKEN=tu_whatsapp_token
# Identificador del número de teléfono en Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# Token de verificación arbitrario inventado por ti (ej: "mi_secreto_padelandia")
# Debes colocar exactamente el mismo al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=tu_verify_token
